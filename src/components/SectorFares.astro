---
import fares from '../data/departures.json';
import { departureCutoff } from '../data/flightAvailability.js';
import { wa } from '../data/site.js';

const money = (n) => n == null ? 'Ask for fare' : '₹' + n.toLocaleString('en-IN');
const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const dateLabel = (s) => day.format(new Date(s + 'T12:00:00Z'));
const builtAt = Date.now();
function availableDates(offer) {
  const dated = offer.validUntil ? [{ pair: offer.validUntil, amount: null }] :
    offer.groups.flatMap(group => group.dates.map(pair => ({ pair, amount: group.fare })));
  return dated.map(date => ({ ...date, cutoff: departureCutoff(offer, date.pair) }))
    .filter(date => date.cutoff > builtAt)
    .sort((a, b) => Number(a.amount == null) - Number(b.amount == null) || a.pair.localeCompare(b.pair));
}
const current = fares.map(offer => ({ ...offer, dates: availableDates(offer) })).filter(offer => offer.dates.length);
const hasPrice = (offer) => offer.dates.some(date => date.amount != null);
function groupByRoute(offers) {
  const routes = new Map();
  for (const fare of offers) {
    const key = fare.validUntil ? fare.airline + ' offers' : fare.origin + ' → ' + fare.destination;
    if (!routes.has(key)) routes.set(key, []);
    routes.get(key).push(fare);
  }
  return [...routes].sort(([, a], [, b]) => Number(b.some(hasPrice)) - Number(a.some(hasPrice)));
}
const sections = ['Domestic', 'International'].map(name => {
  const offers = current.filter(fare => (fare.domestic ? 'Domestic' : 'International') === name);
  return { name, routes: groupByRoute([...offers.filter(hasPrice), ...offers.filter(o => !hasPrice(o))]) };
}).filter(section => section.routes.length);
function priceSummary(offers) {
  const prices = offers.flatMap(offer => offer.dates.filter(date => date.amount != null).map(date => ({ fare:date.amount, kind:offer.kind })));
  if (!prices.length) return 'Ask for fare';
  const lowest = prices.reduce((a,b) => a.fare <= b.fare ? a : b);
  return lowest.kind + ' from ' + money(lowest.fare);
}
---
<section class="fare-board" aria-labelledby="departures-title">
  <div class="eyebrow">Offers</div>
  <h1 id="departures-title">Fixed departure fares</h1>
  <p class="lead">Choose your route and travel dates. Prices are in Indian rupees per person. We confirm seats and the final price before you book.</p>
  <div data-current-fares hidden>
  {sections.length > 1 && <fieldset class="fare-categories">
    <legend class="visually-hidden">Flight category</legend>
    {sections.map(({name}, index) => <label>
      <input class="visually-hidden" type="radio" name="flight-category" value={name} checked={index === 0} aria-controls={'fares-' + name.toLowerCase()} />
      <span>{name}</span>
    </label>)}
  </fieldset>}
  <div class="fare-filters" hidden>
    <label>Flying from<select id="fare-from"><option value="">All departure cities</option></select></label>
    <label>Flying to<select id="fare-to"><option value="">All destinations</option></select></label>
    <span data-count aria-live="polite"></span>
  </div>
  {sections.map(section => <section class="fare-section" id={'fares-' + section.name.toLowerCase()} data-category={section.name} aria-label={section.name + ' flights'}>
    <h2>{section.name} flights</h2>
    <div class="fare-list">
    {section.routes.map(([route, offers]) => (
      <details class="fare-route" data-route={route} data-origin={offers[0].origin} data-destination={offers[0].destination}>
        <summary><span>{route}</span><small data-route-price>{priceSummary(offers)}</small></summary>
        {offers.map(o => {
          const description = route + ', ' + o.airline + ', ' + o.kind + (o.schedule ? ' (' + o.schedule + ')' : '');
          return <article class="fare-option" data-kind={o.kind} data-description={description}>
            <div><h3>{o.airline}</h3><p>{o.kind}{o.schedule && ' · ' + o.schedule}</p>
            {o.baggage && <p>Baggage allowance · {o.baggage}</p>}
            {o.note && <p>{o.note}</p>}
            {o.kind !== 'Package' && o.termsConfirmed !== false && <small>Non-refundable · Changes are not permitted.</small>}</div>
            <div class="fare-choice">
              <label>{o.validUntil ? 'Offer validity' : o.kind === 'One way' ? 'Departure and fare' : 'Departure, return and price'}
                <select>{o.dates.map(d => {
                  const [depart, back] = d.pair.split('/');
                  const label = (o.validUntil ? 'Through ' : '') + dateLabel(depart) + (back ? ' – ' + dateLabel(back) : '');
                  return <option value={depart} data-amount={d.amount} data-cutoff={d.cutoff}>{label} · {money(d.amount)}</option>;
                })}</select>
              </label>
              <a class="btn btn-line" href={wa('Hi LeisureFlies, please check availability for ' + description + '.')} target="_blank" rel="noopener">Check on WhatsApp</a>
            </div>
          </article>;
        })}
      </details>
    ))}
    </div>
  </section>)}
  <p class="note" data-no-fares hidden><span data-empty-message>No upcoming departures match this route.</span> <a href={wa('Hi LeisureFlies, please help me find a flight.')} target="_blank" rel="noopener">Ask us for a fare</a>. <a data-clear-route href="/offers" hidden>See all routes</a></p>
  </div>
  <noscript><p><a href={wa('Hi LeisureFlies, please help me find an upcoming flight.')} target="_blank" rel="noopener">Ask for current flight fares on WhatsApp</a>, or enable JavaScript to browse upcoming departures.</p></noscript>
</section>
<script>
  const board = document.querySelector<HTMLElement>('.fare-board')!;
  const from = board.querySelector<HTMLSelectElement>('#fare-from')!;
  const to = board.querySelector<HTMLSelectElement>('#fare-to')!;
  const routes = [...board.querySelectorAll<HTMLDetailsElement>('.fare-route')];
  const sections = [...board.querySelectorAll<HTMLElement>('.fare-section')];
  const categories = [...board.querySelectorAll<HTMLInputElement>('input[name="flight-category"]')];
  let missingRoute = '';
  function selectedSection() {
    const category = categories.find(input => input.checked)?.value;
    return sections.find(section => section.dataset.category === category) ?? sections[0];
  }
  function updateCities(origin = from.value, destination = to.value) {
    const eligible = [...(selectedSection()?.querySelectorAll<HTMLElement>('.fare-route') ?? [])]
      .filter(route => route.querySelector('.fare-option:not([hidden])'));
    if ((origin || destination) && !eligible.some(route =>
      (!origin || route.dataset.origin === origin) && (!destination || route.dataset.destination === destination))) {
      missingRoute = [origin, destination].filter(Boolean).join(' → ');
    }
    if (origin && !eligible.some(route => route.dataset.origin === origin)) origin = '';
    if (destination && !eligible.some(route => (!origin || route.dataset.origin === origin) && route.dataset.destination === destination)) destination = '';
    function populate(select: HTMLSelectElement, key: 'origin' | 'destination', matches: HTMLElement[], selected: string) {
      const cities = [...new Set(matches.map(route => route.dataset[key]).filter((city): city is string => !!city))].sort();
      select.replaceChildren(select.options[0], ...cities.map(city => new Option(city, city)));
      select.value = selected;
    }
    populate(from, 'origin', eligible.filter(route => !destination || route.dataset.destination === destination), origin);
    populate(to, 'destination', eligible.filter(route => !origin || route.dataset.origin === origin), destination);
  }
  // An offer or route can become enquiry-only when its last priced departure expires.
  function keepPricedFirst(items: NodeListOf<HTMLElement>) {
    let firstUnpriced: HTMLElement | null = null;
    for (const item of items) {
      if (!item.querySelector('option[data-amount]')) firstUnpriced ??= item;
      else if (firstUnpriced) firstUnpriced.before(item);
    }
  }
  function filterRoutes() {
    const active = selectedSection();
    const visibleRoutes = new Set<string>();
    for (const route of routes) {
      route.hidden = !!missingRoute || !active?.contains(route) || !route.querySelector('.fare-option:not([hidden])') ||
        (!!from.value && from.value !== route.dataset.origin) || (!!to.value && to.value !== route.dataset.destination);
      if (!route.hidden && route.dataset.origin) visibleRoutes.add(route.dataset.route!);
    }
    board.querySelector('[data-count]')!.textContent = visibleRoutes.size + (visibleRoutes.size === 1 ? ' route' : ' routes');
    const matching = routes.filter(route => !route.hidden);
    for (const section of sections) section.hidden = !section.querySelector('.fare-route:not([hidden])');
    board.querySelector<HTMLElement>('[data-no-fares]')!.hidden = matching.length > 0;
    board.querySelector('[data-empty-message]')!.textContent = missingRoute ? 'No upcoming departures match ' + missingRoute + '.' : 'No upcoming departures match this route.';
    board.querySelector<HTMLElement>('[data-clear-route]')!.hidden = !missingRoute;
    if (visibleRoutes.size === 1) matching.forEach(route => { route.open = true; });
  }
  let expiryTimer: number | undefined;
  function refreshDepartures() {
    window.clearTimeout(expiryTimer);
    const now = Date.now();
    let nextCutoff = Infinity;
    for (const offer of board.querySelectorAll<HTMLElement>('.fare-option')) {
      const select = offer.querySelector('select')!;
      for (const option of [...select.options]) {
        const cutoff = Number(option.dataset.cutoff);
        if (cutoff > now) nextCutoff = Math.min(cutoff, nextCutoff);
        else option.remove();
      }
      offer.hidden = !select.options.length;
      if (!offer.hidden) updateEnquiry(offer);
    }
    for (const route of routes) {
      const prices = [...route.querySelectorAll<HTMLOptionElement>('.fare-option option[data-amount]')];
      let summary = 'Ask for fare';
      if (prices.length) {
        const lowest = prices.reduce((a,b) => Number(a.dataset.amount) <= Number(b.dataset.amount) ? a : b);
        const kind = lowest.closest<HTMLElement>('.fare-option')!.dataset.kind;
        summary = kind + ' from ₹' + Number(lowest.dataset.amount).toLocaleString('en-IN');
      }
      route.querySelector('[data-route-price]')!.textContent = summary;
      keepPricedFirst(route.querySelectorAll<HTMLElement>('.fare-option'));
    }
    for (const section of sections) keepPricedFirst(section.querySelectorAll<HTMLElement>('.fare-route'));
    for (const input of categories) {
      const section = sections.find(section => section.dataset.category === input.value);
      input.closest('label')!.hidden = !section?.querySelector('.fare-option:not([hidden])');
    }
    const activeExpired = categories.some(input => input.checked && input.closest('label')!.hidden);
    if (activeExpired) {
      const available = categories.find(input => !input.closest('label')!.hidden);
      if (available) available.checked = true;
    }
    const tabs = board.querySelector<HTMLElement>('.fare-categories');
    if (tabs) tabs.hidden = categories.filter(input => !input.closest('label')!.hidden).length < 2;
    updateCities();
    filterRoutes();
    board.querySelector<HTMLElement>('.fare-filters')!.hidden = !board.querySelector('.fare-option:not([hidden])');
    board.querySelector<HTMLElement>('[data-current-fares]')!.hidden = false;
    if (Number.isFinite(nextCutoff)) {
      expiryTimer = window.setTimeout(refreshDepartures, Math.min(nextCutoff - Date.now(), 2_147_483_647));
    }
  }
  function updateEnquiry(offer: HTMLElement) {
    const selected = offer.querySelector('select')!.selectedOptions[0];
    const link = offer.querySelector('a')!;
    const url = new URL(link.href);
    url.searchParams.set('text', 'Hi LeisureFlies, please confirm ' + offer.dataset.description + ' for ' + selected.textContent + '.');
    link.href = url.href;
  }
  board.addEventListener('change', event => {
    const target = event.target as HTMLSelectElement;
    const offer = target.closest<HTMLElement>('.fare-option');
    if (offer) updateEnquiry(offer);
    else {
      missingRoute = '';
      if (target.name === 'flight-category') updateCities('', '');
      else updateCities();
      filterRoutes();
    }
  });
  const query = new URLSearchParams(window.location.search);
  const requestedCategory = categories.find(input => input.value === query.get('category'));
  if (requestedCategory) requestedCategory.checked = true;
  refreshDepartures();
  if (query.has('from') || query.has('to')) {
    const category = query.get('category');
    const origin = query.get('from') || '';
    const destination = query.get('to') || '';
    if (category && category !== selectedSection()?.dataset.category) missingRoute = [origin, destination].filter(Boolean).join(' → ');
    updateCities(origin, destination);
    filterRoutes();
  }
  window.addEventListener('pageshow', refreshDepartures);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshDepartures(); });
</script>
<style>
  .fare-board {padding-bottom:20px}
  h1 {font-size:clamp(36px,5vw,56px);margin-top:8px}
  .fare-categories {display:flex;gap:4px;width:min(100%,440px);min-inline-size:0;padding:5px;margin:22px 0 0;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .fare-categories label {position:relative;flex:1;min-width:0;cursor:pointer}
  .visually-hidden {position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .fare-categories span {display:grid;place-items:center;min-height:46px;border-radius:11px;color:var(--ink);font:700 clamp(16px,2vw,19px) var(--display)}
  .fare-categories label:hover span {background:var(--sky)}
  .fare-categories input:checked + span {background:var(--ink);color:var(--surface)}
  .fare-categories input:focus-visible + span {outline:3px solid var(--turq-deep);outline-offset:2px}
  .fare-board:has(input[value="Domestic"]:checked) #fares-international,
  .fare-board:has(input[value="International"]:checked) #fares-domestic {display:none}
  .fare-filters {display:flex;align-items:end;gap:14px;flex-wrap:wrap;margin:26px 0 18px}
  .fare-board [hidden] {display:none}
  label {display:grid;gap:5px;font-weight:800;font-size:14px}
  select {width:100%;min-width:0;padding:9px 11px;border:1px solid var(--line);border-radius:11px;color:var(--ink);background:var(--surface);font:inherit}
  [data-count] {color:var(--muted);padding-bottom:10px}
  .fare-list {display:grid;gap:9px;margin-top:18px}
  .fare-section {margin-top:28px}
  .fare-route {background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:clip}
  summary {cursor:pointer;padding:14px 20px;font:600 21px var(--display)}
  summary::marker {color:var(--turq-deep);font-size:.8em}
  summary small {font:800 14px var(--body);color:var(--ink);background:var(--sky);border-radius:8px;padding:3px 8px;margin-left:12px}
  summary:focus-visible {outline:3px solid var(--sun);outline-offset:-4px}
  .fare-option {display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,340px);gap:16px;padding:18px 20px;border-top:1px dashed var(--line)}
  .fare-option p,.fare-option small {color:var(--muted);font-size:15px;margin-top:4px}
  .fare-choice a {margin-top:10px;font-size:14px;padding:9px 14px}
  @media(max-width:650px){.fare-option{grid-template-columns:1fr}summary small{display:table;margin:4px 0 0 16px}.fare-filters label{flex:1 1 135px}}
</style>
