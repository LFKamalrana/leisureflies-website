---
interface PackageOption {
  nights: number;
  nightsByCity?: string;
  title?: string;
  slug?: string;
  photo?: { src: string; width: number; height: number };
  difference: string;
  days: string[];
  inclusions: string[];
  exclusions: string[];
  confirm?: string[];
  quoteRoute?: string;
  quoteLabel?: string;
}

interface Props {
  destination: string;
  note: string;
  routes: { slug: string; name: string; quoteRoute: string; packages: PackageOption[] }[];
  quoteOption: (choice: string) => string;
}

const { destination, note, routes, quoteOption } = Astro.props;
---

{note && <p class="plan-note">{note}</p>}
{routes.length > 1 && <nav class="route-links" aria-label={`${destination} package routes`}>
  {routes.map(route => <a href={`#${route.slug}`}>{route.name}</a>)}
</nav>}

{routes.map(route => (
  <section class="route" id={route.slug} aria-labelledby={`${route.slug}-name`}>
    <h3 id={`${route.slug}-name`}>{route.name}</h3>
    <div class:list={['trips', { 'trips-pairs': route.packages.length === 4 }]}>
      {route.packages.map(trip => {
        const duration = `${trip.nights} nights / ${trip.nights + 1} days`;
        const choice = trip.quoteLabel ?? trip.title ?? `${duration} (${trip.quoteRoute ?? route.quoteRoute})`;
        const tripId = trip.slug ?? `${route.slug}-${trip.nights}-nights`;
        const tripName = trip.title ?? `${trip.quoteRoute ?? route.name}, ${duration}`;
        return (
          <article class="trip" id={tripId} aria-labelledby={`${tripId}-name`}>
            {trip.photo && <img class="trip-photo" src={trip.photo.src} width={trip.photo.width} height={trip.photo.height} alt="" loading="lazy" decoding="async" />}
            <h4 id={`${tripId}-name`}>{trip.title ?? duration}</h4>
            {trip.nightsByCity && <p class="city-nights">{trip.nightsByCity}</p>}
            <p class="difference">{trip.difference}</p>
            <details>
              <summary aria-label={`Sample day-wise plan for ${tripName}`}>Sample day-wise plan</summary>
              <ol class="days" role="list">
                {trip.days.map((description, index) => (
                  <li><span class="day-number">Day {index + 1}</span><span>{description}</span></li>
                ))}
              </ol>
            </details>
            <details>
              <summary aria-label={`Inclusions and exclusions for ${tripName}`}>Inclusions and exclusions</summary>
              <div class="terms">
                {trip.inclusions.length > 0 && <div><h5>Included</h5><ul>{trip.inclusions.map(item => <li>{item}</li>)}</ul></div>}
                {trip.exclusions.length > 0 && <div><h5>Excluded</h5><ul>{trip.exclusions.map(item => <li>{item}</li>)}</ul></div>}
                {trip.confirm && trip.confirm.length > 0 && <div><h5>Confirm with your quote</h5><ul>{trip.confirm.map(item => <li>{item}</li>)}</ul></div>}
              </div>
            </details>
            <a class="btn btn-line quote" data-trip-quote href={quoteOption(choice)} aria-label={`Enquire on WhatsApp about ${tripName}`} target="_blank" rel="noopener">Enquire on WhatsApp</a>
          </article>
        );
      })}
    </div>
  </section>
))}

<style>
  .plan-note { max-width: 72ch; margin-top: 12px; color: var(--muted); }
  .route-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .route-links a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 14px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--sky);
    color: var(--ink); font-weight: 700; text-decoration: none;
  }
  .route-links a:hover { text-decoration: underline; }
  .route { margin-top: clamp(24px, 3vw, 40px); padding: 0; }
  .trip, .route { scroll-margin-top: 85px; }
  .route h3 { font-size: clamp(25px, 3vw, 34px); }
  .trips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; align-items: start; margin-top: 14px; }
  .trips-pairs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .trip-photo { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; border-radius: 12px; margin-bottom: 14px; }
  .trip { min-width: 0; padding: clamp(16px, 2vw, 24px); border: 1px solid var(--line); border-radius: 20px; background: var(--surface); }
  .trip h4 { margin: 0; font: 700 clamp(21px, 2vw, 27px)/1.2 var(--display); color: var(--ink); }
  .city-nights { margin-top: 8px; font-weight: 700; font-size: 15px; }
  .difference { margin: 12px 0 16px; color: var(--muted); }
  details { border-top: 1px solid var(--line); }
  summary { padding: 12px 0; color: var(--ink); font-weight: 800; cursor: pointer; }
  summary:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; border-radius: 4px; }
  .days { display: grid; gap: 9px; padding: 0 0 14px; margin: 0; list-style: none; }
  .days li { display: grid; grid-template-columns: max-content 1fr; gap: 9px; font-size: 15px; line-height: 1.5; }
  .day-number { color: var(--ink); font-weight: 800; }
  .terms { display: grid; gap: 12px; padding-bottom: 14px; font-size: 15px; line-height: 1.5; }
  .terms h5 { margin: 0; font: 800 15px/1.5 var(--body); }
  .terms ul { display: grid; gap: 4px; margin: 4px 0 0; padding-inline-start: 19px; }
  .quote { margin-top: 12px; font-size: 15px; }
  @media (max-width: 820px) { .trips { grid-template-columns: 1fr; } }
</style>
