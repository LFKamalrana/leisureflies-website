---
import Base from '../../layouts/Base.astro';
import { SITE, wa } from '../../data/site.js';
import { priceMatchSteps } from '../../data/priceMatch.js';
const ask = wa('Hi LeisureFlies, I want a hotel booking. City: ___ Dates: ___ Guests: ___');
const sts = wa('Hi LeisureFlies, I want to use the Send the Screenshot (STS) offer for a hotel.');
const call = SITE.phones[0];
---
<Base title="4 and 5 Star Hotel Bookings and Price Matching" description="Get a 4 or 5 star hotel quote from an IATA-accredited travel company in Chandigarh, or request a price match on an eligible room." noindex={true}>
  <div class="wrap">
    <section style="padding-block:20px">
      <div class="sts" style="margin-top:10px">
        <div class="bubble" aria-hidden="true"></div>
        <span class="badge">STS PROGRAM · HOTELS</span>
        <h1 style="font-size:clamp(34px,5.4vw,62px)">Found the hotel cheaper? Send the Screenshot.</h1>
        <p class="lead" style="margin-top:14px;font-size:19px">Tell us your hotel and dates for a quote. Found a lower public price for the same room and inclusions? Send a screenshot of the final payment page with the timestamp and total visible.</p>
        <div class="hero-cta">
          <a class="btn btn-line" href="/flights-hotels?service=hotel#quote">Get a hotel quote</a>
          <a class="btn btn-sun" href={sts} target="_blank" rel="noopener">Request a price match</a>
        </div>
      </div>
    </section>

    <section class="sec-block">
      <div class="eyebrow">How it works</div>
      <h2 style="margin-top:8px">How to request a price match</h2>
      <div class="sts" style="margin-top:22px;background:var(--surface);color:var(--ink);box-shadow:var(--shadow);border:1px solid var(--line)">
        <ol class="steps">
          {priceMatchSteps.map(step => <li>{step}</li>)}
        </ol>
      </div>
      <p style="margin-top:14px"><a href="/flights-hotels#price-match">Read the price-match conditions</a></p>
    </section>

    <section class="sec-block">
      <div class="eyebrow">What we book</div>
      <h2 style="margin-top:8px">Deluxe 4 and 5 star hotels.</h2>
      <div class="cards2">
        <div class="info"><h3>IATA accredited</h3><p>Our Chandigarh-based travel company has served more than 20,000 passengers since 2010.</p></div>
        <div class="info"><h3>Hotels and flights together</h3><p>We can book your flights, hotels and visa as one trip.</p></div>
        <div class="info"><h3>Real people on WhatsApp</h3><p>We reply between {SITE.hours}.</p></div>
      </div>
    </section>
    <p style="padding-bottom:90px"></p>
  </div>
  <div class="lp-bar"><a href={`tel:${call.tel}`}>Call</a><a class="w" href={ask} target="_blank" rel="noopener">WhatsApp</a></div>
</Base>
