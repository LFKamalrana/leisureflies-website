---
import KeralaRoute from '../../components/KeralaRoute.astro';
import Base from '../../layouts/Base.astro';
import ArtScene from '../../components/ArtScene.astro';
import raw from '../../data/destinations.json';
import { DEST, wa } from '../../data/site.js';
import { guides } from '../../data/visa';

export function getStaticPaths() {
  return Object.keys(raw).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const d = raw[slug];
const meta = DEST[slug];
const entry = d.entry;
const visaGuide = guides[slug];
const entrySources = entry?.sources ?? visaGuide?.sources ?? [];

// Group the flat content blocks into sections -> intro paragraphs + titled groups.
const sections = [];
let cur = null, grp = null, pendingEyebrow = null;
for (const b of d.blocks) {
  if (b.type === 'eyebrow') { pendingEyebrow = b.text; continue; }
  if (b.type === 'h2') { cur = { eyebrow: pendingEyebrow, title: b.text, options: b.options ?? [], intro: [], groups: [] }; sections.push(cur); grp = null; pendingEyebrow = null; continue; }
  if (!cur) continue;
  if (b.type === 'h3') { grp = { title: b.text, photos: b.photos ?? [], paras: [], items: [], badge: null }; cur.groups.push(grp); continue; }
  if (!grp) { if (b.type === 'p' && b.text.length > 22) cur.intro.push(b.text); continue; }
  if (b.type === 'li') grp.items.push(b.text);
  else if (b.text.length <= 14 && !grp.paras.length && !grp.badge) grp.badge = b.text;
  else grp.paras.push(b.text);
}
const heroImg = d.heroPhoto?.src ?? (meta.photo ? `/img/hero-${slug}.jpg` : null);
const ask = wa(`Hi LeisureFlies, please send me a ${meta.name} package.`);
---
<Base title={`${meta.name} Holiday Packages from Chandigarh`} description={d.description || d.lead} image={heroImg || '/og-image.jpg'}>
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> / <a href="/holidays">Holidays</a> / {meta.name}</div>
    <div class="page-hero">
      {heroImg ? <img src={heroImg} alt={d.heroPhoto?.alt || meta.name} /> : <ArtScene variant={meta.art} wide={true} />}
      <div class="in">
        <h1>{d.title}</h1>
        <p class="lead" style="margin-top:14px">{d.lead}</p>
        {d.chips.length > 0 && <div class="chips">{d.chips.map((c) => <span>{c}</span>)}</div>}
        <div class="hero-cta"><a class="btn btn-wa" href={ask} target="_blank" rel="noopener">Get a free quote</a><a class="btn btn-line" style="color:#fff;box-shadow:inset 0 0 0 2px rgba(255,255,255,.7)" href="/holidays">All holidays</a></div>
      </div>
    </div>

    {sections.map((s) => (
      <section class="sec-block" style="padding-block:clamp(28px,4vw,48px)">
        {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
        <h2 style="margin-top:8px">{s.title}</h2>
        {slug === 'kerala' && s.options.length > 0 && <KeralaRoute />}
        {slug !== 'kerala' && s.options.length > 0 && <ul class="prose">{s.options.map((option) => <li>{option}</li>)}</ul>}
        {s.intro.length > 0 && <div class="prose">{s.intro.map((p) => <p>{p}</p>)}</div>}
        {s.groups.length > 0 && (
          <div class="cards2">
            {s.groups.map((g) => (
              <div class="info">
                {g.badge && <span class="badge-s">{g.badge}</span>}
                <h3>{g.title}</h3>
                {g.paras.map((p) => <p>{p}</p>)}
                {g.photos.length > 0 && (
                  <div class:list={['trip-photos', { 'trip-photos-multiple': g.photos.length > 1 }]}>
                    {g.photos.map((photo) => (
                      <figure>
                        <img src={photo.src} alt={photo.caption ? '' : photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                        {photo.caption && <figcaption>{photo.caption}</figcaption>}
                      </figure>
                    ))}
                  </div>
                )}
                {g.items.length > 0 && <ul>{g.items.map((i) => <li>{i}</li>)}</ul>}
                {slug === 'bali' && g.title.startsWith('Ubud + Kuta') &&
                  <a class="btn btn-line itinerary-quote" data-trip-quote href={wa('Hi LeisureFlies, please quote the Bali itinerary ' + g.title + '.')} target="_blank" rel="noopener">Quote this itinerary</a>}
              </div>
            ))}
          </div>
        )}
      </section>
    ))}

    {entry && <section class="sec-block" id="entry-requirements">
      <h2>Entry requirements for Indian passport holders</h2>
      <div class="prose">
        {entry.advice.map((paragraph) => <p>{paragraph}</p>)}
        {visaGuide && <p><a href={`/visa/${slug}`}>{meta.name} visa fees and document checklist</a></p>}
        <ul>{entrySources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul>
      </div>
    </section>}

    {['bali','maldives'].includes(slug) && <p class="prose"><a href="/holidays/bali-or-maldives">Bali or Maldives? Compare the two holidays →</a></p>}
    <div class="cta-band">
      <div><h2>Ready to plan your {meta.name} trip?</h2><p>Tell us your dates and who is travelling. We reply with a quote built around you. Found a lower price elsewhere on flights or hotels? Send the screenshot and we match it.</p></div>
      <a class="btn btn-sun" href={ask} target="_blank" rel="noopener">Request a free quote</a>
    </div>
  </div>
</Base>

<style>
  .itinerary-quote {margin-top:14px;font-size:15px}
  .trip-photos { display: grid; gap: 10px; margin-top: 16px; }
  .trip-photos-multiple { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .trip-photos figure { margin: 0; }
  .trip-photos img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 12px; }
  .trip-photos figcaption { margin-top: 4px; color: var(--ink); font-size: 14px; font-weight: 800; }
</style>
