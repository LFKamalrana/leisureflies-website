---
import Base from '../../layouts/Base.astro';
import ArtScene from '../../components/ArtScene.astro';
import raw from '../../data/destinations.json';
import { DEST, wa } from '../../data/site.js';

export function getStaticPaths() {
  return Object.keys(raw).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const d = raw[slug];
const meta = DEST[slug];

// Group the flat content blocks into sections -> intro paragraphs + titled groups.
const sections = [];
let cur = null, grp = null, pendingEyebrow = null;
for (const b of d.blocks) {
  if (b.type === 'eyebrow') { pendingEyebrow = b.text; continue; }
  if (b.type === 'h2') { cur = { eyebrow: pendingEyebrow, title: b.text, intro: [], groups: [] }; sections.push(cur); grp = null; pendingEyebrow = null; continue; }
  if (!cur) continue;
  if (b.type === 'h3') { grp = { title: b.text, paras: [], items: [], badge: null }; cur.groups.push(grp); continue; }
  if (!grp) { if (b.type === 'p' && b.text.length > 22) cur.intro.push(b.text); continue; }
  if (b.type === 'li') grp.items.push(b.text);
  else if (b.text.length <= 14 && !grp.paras.length && !grp.badge) grp.badge = b.text;
  else grp.paras.push(b.text);
}
const desc = d.lead.length > 150 ? d.lead.slice(0, 147) + '...' : d.lead;
const heroImg = meta.photo ? `/img/hero-${slug}.jpg` : null;
const ask = wa(`Hi LeisureFlies, please send me a ${meta.name} package.`);
---
<Base title={`${meta.name} Holiday Packages`} description={desc} image={meta.photo ? `/img/hero-${slug}.jpg` : '/og-image.jpg'}>
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> / <a href="/holidays">Holidays</a> / {meta.name}</div>
    <div class="page-hero">
      {heroImg ? <img src={heroImg} alt={`${meta.name}`} /> : <ArtScene variant={meta.art} wide={true} />}
      <div class="in">
        <h1>{d.title}</h1>
        <p class="lead" style="margin-top:14px">{d.lead}</p>
        {d.chips.length > 0 && <div class="chips">{d.chips.map((c) => <span>{c}</span>)}</div>}
        <div class="hero-cta"><a class="btn btn-wa" href={ask} target="_blank" rel="noopener">Get a free quote</a><a class="btn btn-line" style="color:#fff;box-shadow:inset 0 0 0 2px rgba(255,255,255,.7)" href="/holidays">All holidays</a></div>
      </div>
    </div>

    {sections.map((s) => (
      <section class="sec-block" style="padding-block:clamp(28px,4vw,48px)">
        {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
        <h2 style="margin-top:8px">{s.title}</h2>
        {s.intro.length > 0 && <div class="prose">{s.intro.map((p) => <p>{p}</p>)}</div>}
        {s.groups.length > 0 && (
          <div class="cards2">
            {s.groups.map((g) => (
              <div class="info">
                {g.badge && <span class="badge-s">{g.badge}</span>}
                <h3>{g.title}</h3>
                {g.paras.map((p) => <p>{p}</p>)}
                {g.items.length > 0 && <ul>{g.items.map((i) => <li>{i}</li>)}</ul>}
              </div>
            ))}
          </div>
        )}
      </section>
    ))}

    <div class="cta-band">
      <div><h2>Ready to plan your {meta.name} trip?</h2><p>Tell us your dates and who is travelling. We reply with a quote built around you. Found a lower price elsewhere on flights or hotels? Send the screenshot and we match it.</p></div>
      <a class="btn btn-sun" href={ask} target="_blank" rel="noopener">Request a free quote</a>
    </div>
  </div>
</Base>
