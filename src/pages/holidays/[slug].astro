---
import KeralaRoute from '../../components/KeralaRoute.astro';
import PackageComparison from '../../components/PackageComparison.astro';
import Base from '../../layouts/Base.astro';
import ArtScene from '../../components/ArtScene.astro';
import raw from '../../data/destinations.json';
import { DEST, wa } from '../../data/site.js';
import { guides } from '../../data/visa';
import { thailandPlanNote, thailandRoutes } from '../../data/thailandPackages';
import { dubaiPlanNote, dubaiRoutes } from '../../data/dubaiPackages';
import { kashmirPlanNote, kashmirRoutes } from '../../data/kashmirPackages';
import { baliPlanNote, baliRoutes } from '../../data/baliPackages';
import { maldivesPlanNote, maldivesRoutes } from '../../data/maldivesPackages';
import { mauritiusPlanNote, mauritiusRoutes } from '../../data/mauritiusPackages';
import { singaporePlanNote, singaporeRoutes } from '../../data/singaporePackages';
import { vietnamPlanNote, vietnamRoutes } from '../../data/vietnamPackages';
import { sriLankaPlanNote, sriLankaRoutes } from '../../data/sriLankaPackages';
import { goaPlanNote, goaRoutes } from '../../data/goaPackages';

export function getStaticPaths() {
  return Object.keys(raw).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const d = raw[slug];
const meta = DEST[slug];
const comparison = {
  goa: { routes: goaRoutes, note: goaPlanNote },
  'sri-lanka': { routes: sriLankaRoutes, note: sriLankaPlanNote },
  vietnam: { routes: vietnamRoutes, note: vietnamPlanNote },
  singapore: { routes: singaporeRoutes, note: singaporePlanNote },
  mauritius: { routes: mauritiusRoutes, note: mauritiusPlanNote },
  maldives: { routes: maldivesRoutes, note: maldivesPlanNote },
  bali: { routes: baliRoutes, note: baliPlanNote },
  thailand: { routes: thailandRoutes, note: thailandPlanNote },
  dubai: { routes: dubaiRoutes, note: dubaiPlanNote },
  kashmir: { routes: kashmirRoutes, note: kashmirPlanNote },
}[slug];
const entry = d.entry;
const visaGuide = guides[slug];
const entrySources = entry?.sources ?? visaGuide?.sources ?? [];

// Group the flat content blocks into sections -> intro paragraphs + titled groups.
const sections = [];
let cur = null, grp = null, pendingEyebrow = null;
for (const b of d.blocks) {
  if (b.type === 'eyebrow') { pendingEyebrow = b.text; continue; }
  if (b.type === 'h2') { cur = { eyebrow: pendingEyebrow, title: b.text, options: b.options ?? [], intro: [], groups: [] }; sections.push(cur); grp = null; pendingEyebrow = null; continue; }
  if (!cur) continue;
  if (b.type === 'h3') { grp = { title: b.text, photos: b.photos ?? [], paras: [], items: [], badge: null }; cur.groups.push(grp); continue; }
  if (!grp) { if (b.type === 'p' && b.text.length > 22) cur.intro.push(b.text); continue; }
  if (b.type === 'li') grp.items.push(b.text);
  else if (b.text.length <= 14 && !grp.paras.length && !grp.badge) grp.badge = b.text;
  else grp.paras.push(b.text);
}
const heroImg = d.heroPhoto?.src ?? (meta.photo ? `/img/hero-${slug}.jpg` : null);
const ask = wa(`Hi LeisureFlies, I’m interested in your ${meta.name} holiday packages. Please send me an itinerary and a quote.`);
const quoteOption = (option: string) => wa(`Hi LeisureFlies, please quote this ${meta.name} holiday option.\n${option}`);
---
<Base title={`${meta.name} Holiday Packages from Chandigarh`} description={d.description || d.lead} image={heroImg || '/og-image.jpg'} whatsappHref={ask}>
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> / <a href="/holidays">Holidays</a> / {meta.name}</div>
    <div class="page-hero">
      {heroImg ? <img src={heroImg} alt={d.heroPhoto?.alt || meta.name} /> : <ArtScene variant={meta.art} wide={true} />}
      <div class="in">
        <h1>{d.title}</h1>
        <p class="lead" style="margin-top:14px">{d.lead}</p>
        {d.chips.length > 0 && <div class="chips">{d.chips.map((c) => <span>{c}</span>)}</div>}
        <div class="hero-cta"><a class="btn btn-sun" href="#holiday-options">{slug === 'maldives' ? 'Choose a villa' : slug === 'mauritius' ? 'Choose a hotel category' : 'Choose an itinerary'}</a><a class="btn btn-wa" href={ask} target="_blank" rel="noopener">Get a custom quote</a></div>
      </div>
    </div>

    {sections.map((s) => {
      const showComparison = comparison && s.options.length > 0;
      return (
      <section class="sec-block" id={s.options.length ? 'holiday-options' : undefined} style="padding-block:clamp(28px,4vw,48px)">
        {s.eyebrow && <div class="eyebrow">{s.eyebrow}</div>}
        <h2 style="margin-top:8px">{s.title}</h2>
        {slug === 'kerala' && s.options.length > 0 && <KeralaRoute />}
        {showComparison && <PackageComparison destination={meta.name} routes={comparison.routes} note={comparison.note} quoteOption={quoteOption} />}
        {s.options.length > 0 && slug !== 'kerala' && !showComparison && (
          <ul class="package-options">{s.options.map((option) => <li>
            <strong>{option}</strong>
            <a class="btn btn-line" data-trip-quote href={quoteOption(option)} aria-label={`Enquire on WhatsApp about ${meta.name}, ${option}`} target="_blank" rel="noopener">Enquire on WhatsApp</a>
          </li>)}</ul>
        )}
        {s.intro.length > 0 && <div class="prose">{s.intro.map((p) => <p>{p}</p>)}</div>}
        {s.groups.length > 0 && (
          <div class="cards2">
            {s.groups.map((g) => (
              <div class="info">
                {g.badge && <span class="badge-s">{g.badge}</span>}
                <h3>{g.title}</h3>
                {g.paras.map((p) => <p>{p}</p>)}
                {g.photos.length > 0 && (
                  <div class:list={['trip-photos', { 'trip-photos-multiple': g.photos.length > 1 }]}>
                    {g.photos.map((photo) => (
                      <figure>
                        <img src={photo.src} alt={photo.caption ? '' : photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                        {photo.caption && <figcaption>{photo.caption}</figcaption>}
                      </figure>
                    ))}
                  </div>
                )}
                {g.items.length > 0 && <ul>{g.items.map((i) => <li>{i}</li>)}</ul>}
              </div>
            ))}
          </div>
        )}
      </section>
      );
    })}

    {entry && <section class="sec-block" id="entry-requirements">
      <h2>Entry requirements for Indian passport holders</h2>
      <div class="prose">
        {entry.advice.map((paragraph) => <p>{paragraph}</p>)}
        {visaGuide && <p><a href={`/visa/${slug}`}>{meta.name} visa fees and document checklist</a></p>}
        <ul>{entrySources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}</ul>
      </div>
    </section>}

    {['bali','maldives'].includes(slug) && <p class="prose"><a href="/holidays/bali-or-maldives">Bali or Maldives? Compare the two holidays →</a></p>}
    <div class="cta-band">
      <div><h2>Ready to plan your {meta.name} trip?</h2><p>Tell us your dates and who is travelling. We reply with a quote built around you. Found a lower price for the same flight or hotel? <a href="/flights-hotels#price-match">Check the price-match terms</a>.</p></div>
      <a class="btn btn-sun" href={ask} target="_blank" rel="noopener">Request a free quote</a>
    </div>
  </div>
</Base>

<style>
  #holiday-options {scroll-margin-top:80px}
  .package-options {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,245px),1fr));gap:12px;list-style:none;padding:0;margin:20px 0}
  .package-options li {display:flex;flex-direction:column;align-items:start;justify-content:space-between;gap:14px;padding:18px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .package-options .btn {font-size:15px}
  .trip-photos { display: grid; gap: 10px; margin-top: 16px; }
  .trip-photos-multiple { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .trip-photos figure { margin: 0; }
  .trip-photos img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 12px; }
  .trip-photos figcaption { margin-top: 4px; color: var(--ink); font-size: 14px; font-weight: 800; }
</style>
