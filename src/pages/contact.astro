---
import Base from '../layouts/Base.astro';
import { SITE, DEST, wa } from '../data/site.js';
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('LeisureFlies Travels SCO 70 Sector 38-C Chandigarh');
---
<Base title="Contact Us" description="Contact LeisureFlies Travels in Sector 38-C, Chandigarh. Call, WhatsApp or send an enquiry. We reply during office hours, 10 am to 7 pm.">
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> / Contact</div>
    <section style="padding-bottom:10px">
      <div class="eyebrow">Contact</div>
      <h1 style="font-size:clamp(34px,5vw,56px);margin-top:8px">Tell us where you want to go.</h1>
      <p class="lead">The quickest way to reach us is WhatsApp. You can also call, write, or fill in the form and we will come back to you during office hours.</p>
      <div class="hero-cta"><a class="btn btn-wa" href={wa('Hi LeisureFlies, I would like a quote.')} target="_blank" rel="noopener">Chat on WhatsApp</a></div>
    </section>
    <div class="contact-grid">
      <div class="contact-list">
        <div class="contact-card"><small>Call or WhatsApp</small>{SITE.phones.map((p) => <a href={`tel:${p.tel}`}>{p.label}</a>)}</div>
        <div class="contact-card"><small>Email</small><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
        <div class="contact-card"><small>Visit us</small><p>{SITE.address[0]}</p><p>{SITE.address[1]}</p><a href={maps} target="_blank" rel="noopener" style="color:var(--turq-deep)">Open in Google Maps →</a></div>
        <div class="contact-card"><small>Office hours</small><p>{SITE.hours}</p></div>
        <div class="contact-card"><small>Follow us</small><a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a><a href={SITE.facebook} target="_blank" rel="noopener">Facebook</a><a href={SITE.google} target="_blank" rel="noopener">Google reviews</a></div>
      </div>
      <form class="planner" style="display:block;margin:0" action={`https://formsubmit.co/${SITE.email}`} method="POST" id="enquiry">
        <h2 style="font-size:28px">Send an enquiry</h2>
        <input type="hidden" name="_subject" value="New enquiry from leisureflies.com">
        <input type="hidden" name="_captcha" value="false">
        <input type="hidden" name="_next" id="next" value="https://leisureflies.com/thank-you">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
        <div class="form">
          <div class="field"><label for="name">Your name</label><input id="name" name="Name" required autocomplete="name"></div>
          <div class="field"><label for="phone">Phone / WhatsApp</label><input id="phone" name="Phone" type="tel" required autocomplete="tel"></div>
          <div class="field"><label for="email">Email</label><input id="email" name="Email" type="email" autocomplete="email"></div>
          <div class="field"><label for="dest">Destination</label><select id="dest" name="Destination">{Object.values(DEST).map((d) => <option>{d.name}</option>)}<option>Visa help</option><option>Flights or hotels</option><option>Cruise</option><option>Somewhere else</option></select></div>
          <div class="field"><label for="trav">Travellers</label><input id="trav" name="Travellers" type="number" min="1" value="2"></div>
          <div class="field"><label for="when">Travel dates</label><input id="when" name="Dates" placeholder="e.g. 10 to 17 December"></div>
          <div class="field full"><label for="msg">Anything else?</label><textarea id="msg" name="Message"></textarea></div>
          <div class="full"><button class="btn btn-wa" type="submit">Send enquiry</button></div>
        </div>
      </form>
    </div>
  </div>
</Base>
<script is:inline>
  var n=document.getElementById('next');if(n)n.value=location.origin+'/thank-you';
</script>
