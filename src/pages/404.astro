---
import Base from '../layouts/Base.astro';
import { FEATURED, DEST } from '../data/site.js';
---
<Base title="Page Not Found" noindex={true}>
  <div class="wrap" style="padding-block:clamp(48px,8vw,100px)">
    <h1 style="font-size:clamp(34px,6vw,60px)">This page took a different route.</h1>
    <p class="lead">The link may be out of date, or the page may have moved. Here is where to go next.</p>
    <div class="hero-cta"><a class="btn btn-wa" href="/">Home</a><a class="btn btn-line" href="/holidays">All holidays</a><a class="btn btn-line" href="/contact">Contact us</a></div>
    <div class="more" style="margin-top:30px"><b>Popular:</b>{FEATURED.map((s) => <a class="pill" href={`/holidays/${s}`}>{DEST[s].name}</a>)}</div>
  </div>
</Base>
