---
import Base from '../layouts/Base.astro';
import FlightHotelQuote from '../components/FlightHotelQuote.astro';
import { wa } from '../data/site.js';
import { priceMatchConditions, priceMatchIntro, priceMatchSteps } from '../data/priceMatch.js';
---
<Base title="Flight and Hotel Quotes" description="Get a flight or hotel quote for your dates from LeisureFlies in Chandigarh. Found a lower public price? Check the price-match terms and send your screenshot.">
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> / Flights &amp; Hotels</div>
    <section style="padding-block:16px">
      <h1 style="font-size:clamp(34px,5.4vw,62px)">Flights &amp; hotels</h1>
      <p class="lead">Tell us where and when you want to travel. If you already have a lower price for the same booking, you can request a price match.</p>
      <div class="hero-cta"><a class="btn btn-sun" href="#quote">Get a flight or hotel quote</a><a class="btn btn-line" href="#price-match">Request a price match</a></div>
    </section>
    <FlightHotelQuote />
    <section id="price-match" style="padding-bottom:20px;scroll-margin-top:80px">
      <div class="sts" style="margin-top:10px">
        <div class="bubble" aria-hidden="true"></div>
        <span class="badge">STS PROGRAM · AIR TICKETS &amp; HOTELS</span>
        <h2 style="font-size:clamp(30px,4.5vw,50px)">Found it cheaper? Send the Screenshot.</h2>
        <p class="lead" style="margin-top:14px;font-size:19px">{priceMatchIntro}</p>
        <div class="hero-cta"><a class="btn btn-wa" href={wa('Hi LeisureFlies, I want to use the Send the Screenshot (STS) offer.')} target="_blank" rel="noopener">Request a price match</a></div>
      </div>
    </section>

    <section class="sec-block">
      <div class="eyebrow">How it works</div>
      <h2 style="margin-top:8px">How to request a price match</h2>
      <div class="sts" style="margin-top:22px;background:var(--surface);color:var(--ink);box-shadow:var(--shadow);border:1px solid var(--line)">
        <ol class="steps">
          {priceMatchSteps.map(step => <li>{step}</li>)}
        </ol>
      </div>
    </section>

    <section class="sec-block">
      <div class="eyebrow">The conditions</div>
      <h2 style="margin-top:8px">Read these before you send.</h2>
      <div class="prose"><ul>{priceMatchConditions.map(condition => <li>{condition}</li>)}</ul>
        <p><a href="/legal#price-match">Read the full price-match terms</a></p>
      </div>
    </section>

    <section class="sec-block">
      <div class="eyebrow">What we book</div>
      <h2 style="margin-top:8px">Flights and hotels, covered.</h2>
      <div class="cards2" style="grid-template-columns:repeat(2,1fr)">
        <div class="info"><h3>Flights, international and domestic</h3><p>Competitive pricing on both international and domestic air travel, so your journey stays hassle free.</p></div>
        <div class="info"><h3>Hotel reservations</h3><p>A selection of deluxe five-star and four-star hotels, carefully chosen to match your preferences and the standards of Leisureflies.</p></div>
      </div>
    </section>

    <div class="cta-band">
      <div><h2>Have a screenshot ready?</h2><p>Send the final payment page for the flight or hotel you want us to check.</p></div>
      <a class="btn btn-sun" href={wa('Hi LeisureFlies, I want to use the Send the Screenshot (STS) offer.')} target="_blank" rel="noopener">Request a price match</a>
    </div>
  </div>
</Base>
