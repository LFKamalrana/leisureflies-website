---
import Base from '../layouts/Base.astro';
import SectorFares from '../components/SectorFares.astro';
import Offers from '../components/Offers.astro';
import { wa } from '../data/site.js';
---
<Base title="Latest Offers" description="Explore fixed-departure flight fares, round trips and holiday offers. Select travel dates and check availability with LeisureFlies.">
  <div class="wrap"><div class="crumbs"><a href="/">Home</a> / Offers</div><SectorFares /></div>
  <Offers page={true} />
  <div class="wrap"><div class="cta-band">
    <div><h2>Want something different?</h2><p>Tell us your dates and group and we build a package around you. Found a cheaper flight or hotel? <a href="/flights-hotels#price-match">Check the price-match terms</a>.</p></div>
    <a class="btn btn-sun" href={wa('Hi LeisureFlies, I would like a custom package.')} target="_blank" rel="noopener">Ask on WhatsApp</a>
  </div></div>
  <section class="wrap fare-terms" aria-labelledby="fare-terms-title">
    <h2 id="fare-terms-title">Special flight fare terms</h2>
    <ul>
      <li>These special fares apply only to the flights and dates shown. Seats and prices may change before ticketing.</li>
      <li>If you cancel, the base fare is non-refundable. Once ticketed, dates and flights are non-changeable, subject to the airline’s fare rules and applicable law.</li>
      <li>Before paying, check passenger names against travel IDs and confirm the airports, baggage allowance and total price with LeisureFlies.</li>
      <li>If the airline cancels or reschedules your flight, refund and rebooking rights still apply under the relevant rules. Eligible taxes and fees remain refundable.</li>
    </ul>
  </section>
</Base>
<style>
  .fare-terms { padding-block: 28px 40px; }
  .fare-terms ul { padding-inline-start: 1.3em; }
  .fare-terms li { margin-block-start: .45em; }
</style>
