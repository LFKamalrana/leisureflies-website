---
import Base from '../layouts/Base.astro';
import { wa } from '../data/site.js';
---
<Base title="Thank You" noindex={true}>
  <div class="wrap" style="padding-block:clamp(48px,8vw,100px);text-align:center">
    <h1 style="font-size:clamp(36px,6vw,64px)">Thank you!</h1>
    <p class="lead" style="margin-inline:auto">We have your enquiry and will get back to you during office hours. For a faster reply, message us on WhatsApp.</p>
    <div class="hero-cta" style="justify-content:center"><a class="btn btn-wa" href={wa('Hi LeisureFlies, I just sent an enquiry on your website.')} target="_blank" rel="noopener">Chat on WhatsApp</a><a class="btn btn-line" href="/">Back to home</a></div>
  </div>
</Base>
