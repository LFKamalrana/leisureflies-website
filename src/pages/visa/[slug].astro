---
import Base from '../../layouts/Base.astro';
import VisaRates from '../../components/VisaRates.astro';
import { guides, reviewDate, reviewLabel } from '../../data/visa';
import { wa } from '../../data/site.js';
import '../../styles/visa.css';

export function getStaticPaths() {
  return Object.entries(guides).map(([slug, guide]) => ({ params: { slug }, props: { guide } }));
}
const { guide } = Astro.props;
const sections = guide.sections.map((s) => ({
  title: s.title,
  items: s.docs?.map((text) => ({ text, profile: '' })) ??
    Object.entries(s.profiles ?? {}).flatMap(([profile, items]) => items.map((text) => ({ text, profile }))),
}));
const profiles = Object.keys(guide.sections.find((s) => s.profiles)?.profiles ?? {});
const enquiry = wa(`Hi LeisureFlies, please confirm the visa rate and checklist for ${guide.name}. My travel dates are `);
---
<Base title={`${guide.name} Visa Rate and Document Checklist`} description={`Prepare for your ${guide.name} visa application from India. See the LeisureFlies quote, document checklist and official application guidance.`}>
  <div class="wrap visa-pages visa-detail">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/visa">Visa</a> / {guide.name}</nav>
    <section class="visa-guide-head">
      <div>
        <div class="eyebrow">{guide.type}</div>
        <h1>{guide.name} visa checklist</h1>
        <p class="lead">{guide.intro}</p>
        <p class="visa-reviewed">Reviewed <time datetime={reviewDate}>{reviewLabel}</time> · <a href="#official-guidance">Official guidance</a></p>
      </div>
      <aside class="visa-quote" aria-label="LeisureFlies quote per person">
        <h2>LeisureFlies rate per person</h2>
        <VisaRates rates={guide.rates} />
        {guide.rateCaption && <p class="visa-quote-caption">{guide.rateCaption}</p>}
        {guide.rateNote && <p>{guide.rateNote}</p>}
        {!guide.rates.length && <p>Ask for the current price for your dates and application centre.</p>}
        <a class="btn btn-sun no-print" href={enquiry} target="_blank" rel="noopener">{guide.rates.length ? 'Confirm my quote' : 'Request my quote'}</a>
      </aside>
    </section>
    <section class="visa-checklist" aria-labelledby="checklist-title">
      <div class="visa-check-head">
        <div><h2 id="checklist-title">Documents to prepare</h2><p>Tick the items that apply to your trip. Print or save a copy before you leave.</p></div>
        <div class="visa-tools no-print" data-check-tools hidden>
          <button type="button" class="visa-print" id="visa-print">Print checklist</button>
          <button type="button" id="visa-clear" disabled>Clear ticks</button>
        </div>
      </div>
      <div class="visa-check-controls" data-check-tools hidden>
        {profiles.length > 0 && <div class="visa-profile no-print">
          <label for="visa-profile">Applicant profile</label>
          <select id="visa-profile"><option value="">All profiles</option>{profiles.map((p) => <option value={p}>{p}</option>)}</select>
        </div>}
        <span class="visa-progress" id="visa-progress" role="status"></span>
      </div>
      {sections.map((s) => (
        <div class="visa-check-group">
          <h3>{s.title}</h3>
          <ul class="docs">
            {s.items.map((item) => <li data-profile={item.profile}>
              <label><input type="checkbox" /><span>{item.profile && <small>{item.profile}</small>}{item.text}</span></label>
            </li>)}
          </ul>
        </div>
      ))}
    </section>
    <section class="visa-guidance" id="official-guidance" aria-labelledby="official-title">
      <h2 id="official-title">Official guidance</h2>
      {guide.timing && <p>{guide.timing}</p>}
      <ul>{guide.sources.map((s) => <li><a href={s.url}>{s.label}</a></li>)}</ul>
    </section>
    {guide.related?.length && <nav class="visa-related" aria-label="Related checklists">
      <b>Related checklists</b>
      {guide.related.map((slug) => <a href={`/visa/${slug}`}>{guides[slug].name} <span aria-hidden="true">→</span></a>)}
    </nav>}
    <div class="visa-detail-foot no-print"><a href="/visa">← All visa rates and checklists</a><a class="btn btn-line" href={enquiry} target="_blank" rel="noopener">Ask about this application</a></div>
  </div>
</Base>
<script>
  const items = [...document.querySelectorAll<HTMLElement>('.visa-checklist li[data-profile]')];
  const boxes = items.map((item) => item.querySelector<HTMLInputElement>('input')!);
  const profile = document.querySelector<HTMLSelectElement>('#visa-profile');
  const clear = document.querySelector<HTMLButtonElement>('#visa-clear')!;
  const progress = document.querySelector<HTMLElement>('#visa-progress')!;
  function refresh() {
    const selected = profile?.value;
    let total = 0;
    let ticked = 0;
    items.forEach((item, index) => {
      item.hidden = Boolean(selected && item.dataset.profile && item.dataset.profile !== selected);
      if (item.hidden) return;
      total++;
      if (boxes[index].checked) ticked++;
    });
    progress.textContent = `${selected ? selected + ' · ' : ''}${ticked} of ${total} items ticked`;
    clear.disabled = !boxes.some((box) => box.checked);
  }
  document.querySelectorAll<HTMLElement>('[data-check-tools]').forEach((el) => { el.hidden = false; });
  profile?.addEventListener('change', refresh);
  boxes.forEach((box) => box.addEventListener('change', refresh));
  clear.addEventListener('click', () => {
    boxes.forEach((box) => { box.checked = false; });
    refresh();
  });
  document.querySelector('#visa-print')!.addEventListener('click', () => window.print());
  window.addEventListener('pageshow', refresh);
  refresh();
</script>
